# Aegis configuration

APP_ENV=development

# Local model configuration
MODEL_MODE=local
MODEL_DIR=./models

# Local database
DATABASE_URL=

# Local vector database
VECTOR_DB_PATH=./vectorstore

# Authentication
SECRET_KEY=CHANGE_ME

# Network
HOST=127.0.0.1
PORT=8000

# External APIs should remain disabled for sovereign mode
ALLOW_EXTERNAL_APIS=false
